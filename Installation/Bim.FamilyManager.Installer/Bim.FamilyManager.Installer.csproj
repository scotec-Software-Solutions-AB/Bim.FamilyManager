<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <OutputType></OutputType>
	  <TargetFramework>net4.7.2</TargetFramework>
	  <UseWpf>true</UseWpf>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Icons\BackgroundWithoutText.png" />
    <None Remove="Resources\Icons\BackgroundWithText.png" />
    <None Remove="Resources\Icons\Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Icons\BackgroundWithoutText.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Icons\BackgroundWithText.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Icons\Logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

	<ItemGroup>
    <PackageReference Include="WixSharp-wix4.WPF" Version="2.12.2" />
    <PackageReference Include="WixSharp_wix4" Version="2.12.2" />
  </ItemGroup>

	<ItemGroup>
	  <None Update="Resources\Icons\Logo.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
