<UserControl x:Class="Bim.FamilyManager.Installer.InstallScopeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="640">


    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Description -->
        <!-- Options -->
        <StackPanel Grid.Row="2" Orientation="Vertical">

            <RadioButton GroupName="InstallScope"
                         Margin="0,0,0,10"
                         IsChecked="{Binding IsUserScope, Mode=TwoWay}" 
                         Click="RadioButtonOnClick">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Install only for me (per-user)" />
                    <TextBlock Foreground="#FF555555"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Text="Recommended if you do not have admin rights. Installs into your user profile and affects only your account."/>
                </StackPanel>
            </RadioButton>

            <RadioButton GroupName="InstallScope"
                         Margin="0,0,0,10"
                         IsChecked="{Binding IsMachineScope, Mode=TwoWay}"
                         Click="RadioButtonOnClick">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="Install for all users (per-machine)" />
                    <TextBlock Foreground="#FF555555"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Text="Recommended on shared computers. Installs into a machine-wide location. Administrator privileges may be required."/>
                </StackPanel>
            </RadioButton>

            <!-- Optional hint -->
            <Border Margin="0,10,0,0"
                    Padding="10"
                    CornerRadius="6"
                    Background="#FFFEF7E0"
                    BorderBrush="#FFE7D49A"
                    BorderThickness="1"
                    Visibility="{Binding IsAdminRequiredVisible, FallbackValue=Collapsed}">
                <TextBlock TextWrapping="Wrap" FontSize="12">
                    <Bold>Note:</Bold>
                    Choosing “Install for all users” can trigger an elevation prompt. If you cannot provide admin credentials, choose “Install only for me”.
                </TextBlock>
            </Border>

        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="3"
                   Margin="0,16,0,0"
                   FontSize="11"
                   Foreground="#FF777777"
                   TextWrapping="Wrap"
                   Text="You can change this later by uninstalling and reinstalling with a different scope."/>
    </Grid>
</UserControl>
