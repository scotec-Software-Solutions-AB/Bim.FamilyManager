<UserControl x:Class="Bim.FamilyManager.Installer.RevitVersionSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Bim.FamilyManager.Installer"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="640">

    <UserControl.Resources>
        <local:BoolToCollapsedConverter x:Key="BoolToCollapsedConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   Text="Select the Revit versions for which BIM.FamilyManager should be installed. Only versions detected on this machine can be selected."/>

        <!-- Version list -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Versions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Margin="0,6,0,6"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsSelectable}"
                              Click="CheckBoxOnClick">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding DisplayLabel}"/>
                            <TextBlock Foreground="#FF555555"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       Text="Not installed on this machine."
                                       Visibility="{Binding IsDetected,
                                           Converter={StaticResource BoolToCollapsedConverter}}"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Validation hint -->
        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#FFCC3300"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Name="ValidationHint"
                   Text="Please select at least one installed Revit version."
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
