<UserControl x:Class="Bim.FamilyManager.Installer.InstallScopeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Bim.FamilyManager.Installer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Choose installation scope:" Margin="0,0,0,10"/>
            <RadioButton x:Name="AllUsersRadioButton" Content="All Users (requires admin)" IsChecked="True"/>
            <RadioButton x:Name="SingleUserRadioButton" Content="Only for me"/>
        </StackPanel>
    </Grid>
</UserControl>
