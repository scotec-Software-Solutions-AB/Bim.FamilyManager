<wpf:RevitPage x:Class="Bim.FamilyManager.Ui.Views.FamilyManagerPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:viewModels="clr-namespace:Bim.FamilyManager.Abstractions.ViewModels;assembly=Bim.FamilyManager.Abstractions"
      xmlns:wpf="clr-namespace:Scotec.Revit.Wpf;assembly=Scotec.Revit.Wpf"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="400"
      d:DataContext="{d:DesignInstance viewModels:IFamilyManagerViewModel, IsDesignTimeCreatable=false}"
      Title="FamilyManagerView">

    <wpf:RevitPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </wpf:RevitPage.Resources>

    <Grid Background="{StaticResource SecondaryBackgroundBrush}">
        <ContentPresenter Content="{Binding}" ContentTemplateSelector="{Binding DataTemplateSelector}" />
    </Grid>

</wpf:RevitPage>