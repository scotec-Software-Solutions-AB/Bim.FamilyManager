<UserControl x:Class="Bim.FamilyManager.Ui.Views.Settings.FamilySourcesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:Bim.FamilyManager.Ui.ViewModels.Settings"
             xmlns:settings1="clr-namespace:Bim.FamilyManager.Ui.Views.Settings"
             xmlns:controls="clr-namespace:Bim.FamilyManager.Ui.Controls"
             xmlns:resources="clr-namespace:Bim.FamilyManager.Ui.Resources"
             xmlns:viewModels1="clr-namespace:Bim.FamilyManager.Abstractions.ViewModels.Settings;assembly=Bim.FamilyManager.Abstractions"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance settings:FamilySourcesSettingsViewModel, IsDesignTimeCreatable=false}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <settings1:SettingsContentDialog Grid.Row="0" Content="{Binding EditViewModel}"
                                         IsDialogVisible="{Binding IsEditing}" />
        <settings1:SettingsContentDialog Grid.Row="0" Content="{Binding SelectionViewModel}"
                                         IsDialogVisible="{Binding IsSelecting}" />

        <Border Grid.Row="0" Padding="5" Background="#e0f3e8">
            <TextBlock Text="{x:Static resources:StringResources.FamilySourceSettings_SourcesSettingsView_Description}"
                       Margin="0" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
            <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonAddBrush}"
                                         Background="{StaticResource PrimaryBackgroundBrush}"
                                         Content="{x:Static resources:StringResources.FamilySourceSettings_Button_Add}"
                                         BorderThickness="0,0,1,0" Kind="{StaticResource IconFolderAdd}"
                                         Command="{Binding Path=AddCommand}" />

            <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonEditBrush}" Margin="15,0,0,0"
                                         Background="{StaticResource PrimaryBackgroundBrush}"
                                         Content="{x:Static resources:StringResources.FamilySourceSettings_Button_Edit}"
                                         BorderThickness="0,0,1,0" Kind="{StaticResource IconFolderEdit}"
                                         Command="{Binding Path=EditCommand}" />

            <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonRemoveBrush}" Margin="15,0,0,0"
                                         Background="{StaticResource PrimaryBackgroundBrush}"
                                         Content="{x:Static resources:StringResources.FamilySourceSettings_Button_Remove}"
                                         BorderThickness="0,0,1,0" Kind="{StaticResource IconFolderRemove}"
                                         Command="{Binding Path=RemoveCommand}" />

        </StackPanel>

        <ListView Grid.Row="2"
                  Margin="5"
                  ItemsSource="{Binding FamilySourceSettings}"
                  SelectedItem="{Binding SelectedFamilySourceSettings, Mode=TwoWay}"
                  SelectionMode="Single"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="{StaticResource PrimaryBackgroundBrush}">
            <ListView.View>
                <GridView>
                    <!-- Checkbox Column -->
                    <GridViewColumn Header="{x:Static resources:StringResources.FamilySourceSettings_Column_Active}"
                                    Width="60">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="{x:Type GridViewColumnHeader}"
                                   BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type viewModels1:IFamilySourceSettingsViewModel}">
                                <Grid>
                                    <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Directory Name Column -->
                    <GridViewColumn Header="{x:Static resources:StringResources.FamilySourceSettings_Column_Name}"
                                    Width="Auto">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="{x:Type GridViewColumnHeader}"
                                   BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                <Setter Property="IsHitTestVisible" Value="True" />
                                <Setter Property="MinWidth" Value="200" />
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type viewModels1:IFamilySourceSettingsViewModel}">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Source Column -->
                    <GridViewColumn Header="{x:Static resources:StringResources.FamilySourceSettings_Column_Source}"
                                    Width="Auto">
                        <GridViewColumn.HeaderContainerStyle>
                            <Style TargetType="{x:Type GridViewColumnHeader}"
                                   BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                <Setter Property="IsHitTestVisible" Value="True" />
                                <Setter Property="MinWidth" Value="300" />
                            </Style>
                        </GridViewColumn.HeaderContainerStyle>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type viewModels1:IFamilySourceSettingsViewModel}">
                                <TextBlock Text="{Binding Source}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Buttons Column -->
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</UserControl>