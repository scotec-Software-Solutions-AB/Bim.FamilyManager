<UserControl x:Class="Bim.FamilyManager.Ui.Views.Settings.FamilySourceSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:Bim.FamilyManager.Ui.Resources"
             xmlns:controls="clr-namespace:Bim.FamilyManager.Ui.Controls"
             xmlns:settings="clr-namespace:Bim.FamilyManager.Ui.ViewModels.Settings"
             xmlns:viewModels1="clr-namespace:Bim.FamilyManager.Abstractions.ViewModels.Settings;assembly=Bim.FamilyManager.Abstractions"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance settings:FamilySourceSelectionViewModel, IsDesignTimeCreatable=false}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="10,10,10,0" />
            </Style>

            <DataTemplate x:Key="ListBoxItemTemplate" DataType="{x:Type viewModels1:IFamilySourceSettingsViewModel}">
                <TextBlock Text="{Binding TypeName}" VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight"
                           Margin="5" />
            </DataTemplate>

        </ResourceDictionary>

    </UserControl.Resources>


    <Grid Background="{StaticResource SecondaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource PrimaryBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="5" Background="#e0f3e8">
                <TextBlock Text="{x:Static resources:StringResources.FamilySourceSettings_SelectionView_Description}"
                           Margin="0" TextWrapping="Wrap" />
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{x:Static resources:StringResources.FamilySourceSettings_Text_SelectSourceType}" />
            <ListBox Grid.Row="2" Style="{StaticResource SettingsListBoxStyle}"
                     Width="250" MinHeight="100" HorizontalAlignment="Left"
                     Margin="10,5,10,0" BorderThickness="1"
                     ItemContainerStyle="{StaticResource SymbolListBoxItemStyle}"
                     ItemTemplate="{StaticResource ListBoxItemTemplate}"
                     ItemsSource="{Binding FamilySources}"
                     SelectedItem="{Binding SelectedFamilySource}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">

            <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonOkBrush}"
                                         Content="{x:Static resources:StringResources.FamilySourceSettings_Button_Ok}"
                                         Kind="{StaticResource IconOk}" Command="{Binding Path=ApplyCommand}" />

            <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonCancelBrush}"
                                         Margin="15,0,0,0"
                                         Content="{x:Static resources:StringResources.FamilySourceSettings_Button_Cancel}"
                                         Kind="{StaticResource IconCancel}" Command="{Binding Path=CancelCommand}" />
        </StackPanel>

    </Grid>
</UserControl>