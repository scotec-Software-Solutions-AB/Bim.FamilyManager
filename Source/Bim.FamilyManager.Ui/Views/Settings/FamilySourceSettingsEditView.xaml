<UserControl x:Class="Bim.FamilyManager.Ui.Views.Settings.FamilySourceSettingsEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Bim.FamilyManager.Ui.Controls"
             xmlns:settings="clr-namespace:Bim.FamilyManager.Ui.ViewModels.Settings"
             xmlns:resources="clr-namespace:Bim.FamilyManager.Ui.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance settings:FamilySourceSettingsEditViewModel, IsDesignTimeCreatable=false}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="10,10,10,0" />
            </Style>

        </ResourceDictionary>

    </UserControl.Resources>


    <Grid Background="{StaticResource SecondaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <ResourceDictionary />
        </Grid.Resources>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--<TextBlock Grid.Row="0" Text="{x:Static resources:StringResources.FamilySourceSettings_Text_SelectSourceType}"/>
            <ComboBox Grid.Row="1" Style="{StaticResource FamilyManagerComboBoxStyle}"
                      Width="200" HorizontalAlignment="Left"
                      Margin="10,5,10,0"
                      ItemsSource="{Binding FamilySources}"
                      SelectedItem="{Binding SelectedFamilySource}"
                      DisplayMemberPath="TypeName"/>-->
        </Grid>

        <ContentPresenter Grid.Row="1" Content="{Binding SelectedFamilySource}"
                          ContentTemplateSelector="{Binding DataTemplateSelector}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
            <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonOkBrush}"
                                         Content="{x:Static resources:StringResources.FamilySourceSettings_Button_Ok}"
                                         Kind="{StaticResource IconOk}" Command="{Binding Path=ApplyCommand}" />

            <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonCancelBrush}"
                                         Margin="15,0,0,0"
                                         Content="{x:Static resources:StringResources.FamilySourceSettings_Button_Cancel}"
                                         Kind="{StaticResource IconCancel}" Command="{Binding Path=CancelCommand}" />

        </StackPanel>

    </Grid>
</UserControl>