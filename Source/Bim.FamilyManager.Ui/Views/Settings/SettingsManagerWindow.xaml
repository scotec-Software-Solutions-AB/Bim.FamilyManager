<sco:RevitWindow x:Class="Bim.FamilyManager.Ui.Views.Settings.SettingsManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:sco="clr-namespace:Scotec.Revit.Wpf;assembly=Scotec.Revit.Wpf"
                 xmlns:controls="clr-namespace:Bim.FamilyManager.Ui.Controls"
                 xmlns:settings="clr-namespace:Bim.FamilyManager.Ui.ViewModels.Settings"
                 xmlns:resources="clr-namespace:Bim.FamilyManager.Ui.Resources"
                 mc:Ignorable="d"
                 Title="{x:Static resources:StringResources.SettingsManager_Window_Title}" Height="450" Width="800"
                 WindowStartupLocation="CenterOwner"
                 SizeToContent="Manual"
                 d:DataContext="{d:DesignInstance settings:SettingsManagerViewModel, IsDesignTimeCreatable=false}">

    <sco:RevitWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>


        </ResourceDictionary>
    </sco:RevitWindow.Resources>

    <Grid Background="{StaticResource SecondaryBackgroundBrush}">
        <Grid Margin="5,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Grid.Column="0" Source="{Binding Logo}"
                   Height="16" Margin="8,0,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />

            <ListBox Grid.Row="2" Grid.Column="0" MinWidth="200"
                     Style="{StaticResource SettingsListBoxStyle}"
                     ItemContainerStyle="{StaticResource SettingsListBoxItemStyle}"
                     ItemTemplate="{StaticResource SettingsListBoxItemTemplate}"
                     Background="Transparent"
                     Padding="0,5,0,0"
                     ItemsSource="{Binding Settings}"
                     SelectedItem="{Binding SelectedSettings}" />

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                        Margin="5,0,0,0">
                <Image Source="{Binding SelectedSettings.DefaultImageSource}" Height="20" Margin="0,0,10,0"
                       VerticalAlignment="Center" />
                <TextBlock Text="{Binding SelectedSettings.Name}"
                           Style="{StaticResource TitleStyle}" VerticalAlignment="Center" />

            </StackPanel>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0,1,0,0" BorderBrush="#c29c66"
                    Background="Transparent" Margin="0,5,0,10" />

            <Grid Grid.Row="2" Grid.Column="1"
                  Margin="3,8,10,3"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="{StaticResource PrimaryBackgroundBrush}">
                <ContentControl Content="{Binding SelectedSettings}"
                                ContentTemplateSelector="{Binding DataTemplateSelector}" />
            </Grid>

            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,10,10,10">
                <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonSaveBrush}"
                                             Content="Save" Kind="{StaticResource IconSave}"
                                             Command="{Binding Path=SaveCommand}" />
                <controls:MaterialIconButton Height="32" Foreground="{StaticResource ButtonCancelBrush}"
                                             Margin="15,0,0,0" Content="Cancel" Kind="{StaticResource IconCancel}"
                                             Command="{Binding Path=CloseCommand}" />

            </StackPanel>
        </Grid>
    </Grid>
</sco:RevitWindow>