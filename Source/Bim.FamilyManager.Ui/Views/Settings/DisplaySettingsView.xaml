<UserControl x:Class="Bim.FamilyManager.Ui.Views.Settings.DisplaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:Bim.FamilyManager.Ui.ViewModels.Settings"
             xmlns:resources="clr-namespace:Bim.FamilyManager.Ui.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance settings:DisplaySettingsViewModel, IsDesignTimeCreatable=false}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Padding="5" Background="#e0f3e8">
            <TextBlock Text="{x:Static resources:StringResources.DisplaySettings_View_Description}"
                       Margin="0" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="10,10,0,0">
            <TextBlock Text="{x:Static resources:StringResources.DisplaySettings_Text_Layout}"
                       VerticalAlignment="Center" />
            <ComboBox Style="{StaticResource FamilyManagerComboBoxStyle}" Width="200" Margin="5,0,0,0"
                      ItemsSource="{Binding LayoutOptions}" DisplayMemberPath="LayoutName"
                      SelectedItem="{Binding SelectedLayoutOptions}" />
        </StackPanel>

        <ContentPresenter Grid.Row="2" Margin="10"
                          Content="{Binding SelectedLayoutOptions, FallbackValue='#Layout settings content'}"
                          ContentTemplateSelector="{Binding DataTemplateSelector}" />
    </Grid>
</UserControl>