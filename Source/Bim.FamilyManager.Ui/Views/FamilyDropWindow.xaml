<wpf:RevitWindow x:Class="Bim.FamilyManager.Ui.Views.FamilyDropWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:wpf="clr-namespace:Scotec.Revit.Wpf;assembly=Scotec.Revit.Wpf"
                 xmlns:resources="clr-namespace:Bim.FamilyManager.Ui.Resources"
                 xmlns:viewModels="clr-namespace:Bim.FamilyManager.Abstractions.ViewModels;assembly=Bim.FamilyManager.Abstractions"
                 mc:Ignorable="d"
                 Title="{x:Static resources:StringResources.FamilyDropWindow_Title}"
                 Height="450" Width="800"
                 d:DataContext="{d:DesignInstance viewModels:IFamilyDropViewModel, IsDesignTimeCreatable=false}"
                 SizeToContent="WidthAndHeight"
                 ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ListBoxItemTemplate" DataType="{x:Type viewModels:IFamilyViewModel}">
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           ToolTip="{Binding Path=Name}" ToolTipService.InitialShowDelay="2000"
                           ToolTipService.BetweenShowDelay="1000" />
            </DataTemplate>


        </ResourceDictionary>
    </Window.Resources>


    <Grid MaxWidth="600" MaxHeight="300" Background="{StaticResource SecondaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="{Binding Family.Preview}" Height="48" Width="48"
                   Margin="3" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource HeaderStyle}"
                       Text="{Binding Path=Family.Name, FallbackValue='#Family'}"
                       MaxHeight="48" Margin="5,3,15,3"
                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       ToolTip="{Binding Path=Family.Name}" ToolTipService.InitialShowDelay="2000"
                       ToolTipService.BetweenShowDelay="1000" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="5"
                   Text="{x:Static resources:StringResources.FamilyDropWindow_SelectionText}" />

        <ListBox Grid.Row="2"
                 BorderThickness="0"
                 Background="{StaticResource BackgroundBrush}"
                 Margin="5"
                 ItemContainerStyle="{StaticResource SymbolListBoxItemStyle}"
                 ItemTemplate="{StaticResource ListBoxItemTemplate}"
                 ItemsSource="{Binding Family.Symbols}"
                 SelectedItem="{Binding SelectedSymbol}" />

    </Grid>
</wpf:RevitWindow>