<UserControl x:Class="Bim.FamilyManager.Ui.FamilyExplorer.Views.LayoutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:resources="clr-namespace:Bim.FamilyManager.Ui.FamilyExplorer.Resources"
             xmlns:viewModels="clr-namespace:Bim.FamilyManager.Ui.FamilyExplorer.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance viewModels:LayoutOptionsViewModel, IsDesignTimeCreatable=false}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="10,10,0,0">
            <CheckBox IsChecked="{Binding ShowPreviewImage}" Margin="0" />
            <TextBlock Text="{x:Static resources:StringResources.LayoutSettings_Text_ShowImage}" Margin="5,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="10,10,0,0">
            <CheckBox IsChecked="{Binding ShowItemName}" Margin="0" />
            <TextBlock Text="{x:Static resources:StringResources.LayoutSettings_Text_ShowName}" Margin="5,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="10,20,10,0">

            <!-- Define Row Definitions -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Static resources:StringResources.LayoutSettings_Text_ContentHeight}" />
            <!-- Slider Control -->
            <Slider x:Name="ValueSlider"
                    Minimum="{Binding ContentMinHeight}"
                    Maximum="{Binding ContentMaxHeight}"
                    Value="{Binding ContentHeight}"
                    HorizontalAlignment="Stretch"
                    Margin="0,3,0,0"
                    Grid.Row="1"
                    TickFrequency="1"
                    IsSnapToTickEnabled="false" Ticks="48,64,80,96,112" TickPlacement="BottomRight"
                    MinWidth="200" />
            <!-- TextBlocks for Min, Max, and Current Value -->
            <Grid Grid.Row="2" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Min Value -->
                <TextBlock Text="{Binding ContentMinHeight, FallbackValue=0}"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Grid.Column="0" />
                <!-- Current Value -->
                <TextBlock Text="{Binding ElementName=ValueSlider, Path=Value, StringFormat=F0}"
                           VerticalAlignment="Bottom" Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Grid.Column="0" />
                <!-- Max Value -->
                <TextBlock Text="{Binding ContentMaxHeight, FallbackValue=0}"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Right"
                           Grid.Column="0" />
            </Grid>
        </Grid>


    </Grid>
</UserControl>