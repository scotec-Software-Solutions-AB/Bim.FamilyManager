<wpf:RevitUserControl x:Class="Bim.FamilyManager.Ui.FamilyExplorer.Views.FamilyManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Scotec.Wpf.Controls;assembly=Scotec.Wpf.Controls"
             xmlns:converter="clr-namespace:Scotec.Wpf.Converter;assembly=Scotec.Wpf.Controls"
             xmlns:controls1="clr-namespace:Bim.FamilyManager.Ui.Controls;assembly=Bim.FamilyManager.Ui"
             xmlns:resources="clr-namespace:Bim.FamilyManager.Ui.FamilyExplorer.Resources"
             xmlns:viewModels1="clr-namespace:Bim.FamilyManager.Abstractions.ViewModels;assembly=Bim.FamilyManager.Abstractions"
             xmlns:views1="clr-namespace:Bim.FamilyManager.Ui.Views;assembly=Bim.FamilyManager.Ui"
             xmlns:views="clr-namespace:Bim.FamilyManager.Ui.FamilyExplorer.Views"
             xmlns:viewModels="clr-namespace:Bim.FamilyManager.Ui.FamilyExplorer.ViewModels"
             xmlns:wpf="clr-namespace:Scotec.Revit.Wpf;assembly=Scotec.Revit.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance viewModels:FamilyManagerViewModel, IsDesignTimeCreatable=false}">

    <wpf:RevitUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converter:BooleanToVisibilityConverter x:Key="TrueToVisibleConverter" TrueVisibility="Visible"
                                                    FalseVisibility="Collapsed" />
            <converter:BooleanToVisibilityConverter x:Key="FalseToVisibleConverter" TrueVisibility="Collapsed"
                                                    FalseVisibility="Visible" />

        </ResourceDictionary>
    </wpf:RevitUserControl.Resources>

    <Grid Background="{StaticResource SecondaryBackgroundBrush}">
        <Grid Margin="5,0,5,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <views:FamilySourcesView Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Top">
                    <controls1:MaterialIconButton Padding="2" IconSize="32" Foreground="#b066c2"
                                                  BorderThickness="0" Kind="{StaticResource IconReload}"
                                                  ToolTip="{x:Static resources:StringResources.FamilyManager_Button_Refresh}"
                                                  Command="{Binding Path=ReloadCommand}" BorderBrush="#FFABADB3" />

                    <controls1:MaterialIconButton Padding="2" IconSize="32" Foreground="#c26666"
                                                  BorderThickness="0" Kind="{StaticResource IconSettings}"
                                                  ToolTip="{x:Static resources:StringResources.FamilyManager_Button_Settings}"
                                                  Click="OnSettingsButtonClick" BorderBrush="#FFABADB3" />

                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <ComboBox ItemsSource="{Binding SelectedFamilySource.Folders, FallbackValue={x:Null}}"
                          SelectedItem="{Binding SelectedFamilySource.SelectedFolder, FallbackValue={x:Null}}"
                          Style="{StaticResource FamilyManagerComboBoxStyle}"
                          MaxWidth="400"
                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Left"
                          MaxDropDownHeight="500"
                          SelectionChanged="OnSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:FolderViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>


            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <controls:ExtendedTextBox Text="{Binding Path=SearchPattern, UpdateSourceTrigger=PropertyChanged}"
                                          MaxWidth="400"
                                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                          Margin="0,10,0,10"
                                          HorizontalAlignment="Left"
                                          HorizontalContentAlignment="Stretch"
                                          Watermark="{x:Static resources:StringResources.FamilyManager_Search_Watermark}"
                                          WatermarkForeground="{StaticResource SecondaryBrush}"
                                          ImageSource="pack://application:,,,/Bim.FamilyManager.Ui;component/Resources/Images/SearchSecondary_24x24.png"
                                          ButtonImageSource="pack://application:,,,/Bim.FamilyManager.Ui;component/Resources/Images/ClearSecondary_24x24.png"
                                          VerticalContentAlignment="Center"
                                          Background="White"
                                          ButtonTooltip="{x:Null}" ImageTooltip="{x:Null}" Grid.ColumnSpan="2" />
            </Grid>

            <Border Grid.Row="4"
                    Background="{StaticResource PrimaryBackgroundBrush}"
                    BorderThickness="1,1,1,1"
                    BorderBrush="#FFABADB3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Row="0" Content="{Binding SelectedFamilySource.Panel, FallbackValue={x:Null}}"
                                    ContentTemplateSelector="{Binding DataTemplateSelector}" />
                    <ScrollViewer Grid.Row="1" x:Name="ScrollViewer" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Hidden">
                        <!-- Use ItemsControl with StackPanel as ItemsPanel -->
                        <Grid>
                            <ItemsControl Width="{Binding ViewportWidth, ElementName=ScrollViewer}"
                                          ItemsSource="{Binding SelectedFamilySource.SelectedFolder.Subfolders, FallbackValue={x:Null}}"
                                          Visibility="{Binding IsActiveSearch, Converter={StaticResource FalseToVisibleConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:FolderViewModel}">
                                        <views:FolderView />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Width="{Binding ViewportWidth, ElementName=ScrollViewer}"
                                          ItemsSource="{Binding SearchResult}"
                                          Visibility="{Binding IsActiveSearch, Converter={StaticResource TrueToVisibleConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels1:IFamilyViewModel}">
                                        <views1:FamilyView />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>


</wpf:RevitUserControl>