<UserControl x:Class="Bim.FamilyManager.Ui.FamilyExplorer.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:Bim.FamilyManager.Abstractions.ViewModels;assembly=Bim.FamilyManager.Abstractions"
             xmlns:views="clr-namespace:Bim.FamilyManager.Ui.Views;assembly=Bim.FamilyManager.Ui"
             d:DataContext="{d:DesignInstance viewModels:IFolderViewModel, IsDesignTimeCreatable=false}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="Gray" BorderThickness="0" Margin="5">
            <StackPanel Orientation="Vertical">
                <!-- ToggleButton to control visibility -->
                <StackPanel Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource ExpandButtonStyle}"
                                  RenderTransformOrigin="-1.712,-2.633" />
                    <!-- Header displaying the Name -->
                    <TextBlock Text="{Binding Name, FallbackValue='#Header'}" Margin="5,0,0,0"
                               Style="{StaticResource HeaderStyle}"
                               LineHeight="16px" VerticalAlignment="Center" />

                </StackPanel>
                <ItemsControl x:Name="ItemsControl" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Families}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:IFamilyViewModel}">
                            <views:FamilyView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>