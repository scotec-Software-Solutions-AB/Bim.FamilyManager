<UserControl x:Class="Bim.FamilyManager.Source.Directory.Views.Settings.DirectorySourceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Scotec.Wpf.Controls;assembly=Scotec.Wpf.Controls"
             xmlns:controls1="clr-namespace:Bim.FamilyManager.Ui.Controls;assembly=Bim.FamilyManager.Ui"
             xmlns:resources="clr-namespace:Bim.FamilyManager.Source.Directory.Resources"
             xmlns:settings="clr-namespace:Bim.FamilyManager.Source.Directory.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance settings:DirectorySourceSettingsViewModel, IsDesignTimeCreatable=false}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/Bim.FamilyManager.Ui;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <ResourceDictionary>

                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="10,10,10,0" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="10,5,10,0" />
                </Style>
                <Style TargetType="controls:ExtendedTextBox">
                    <Setter Property="Margin" Value="10,5,10,0" />
                </Style>

            </ResourceDictionary>
        </Grid.Resources>

        <Border Grid.Row="0" Background="#e0f3e8" Padding="5">
            <TextBlock Text="{x:Static resources:StringResources.DirectorySourceSettings_Text_Description}"
                       TextWrapping="Wrap" Margin="0" />
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{x:Static resources:StringResources.DirectorySourceSettings_Text_Name}" />
        <controls:ExtendedTextBox Grid.Row="2" Width="200"
                                  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Left"
                                  Watermark="{x:Static resources:StringResources.DirectorySourceSettings_Text_Name_Watermark}" />

        <TextBlock Grid.Row="3"
                   Text="{x:Static resources:StringResources.DirectorySourceSettings_Text_Directory}" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:ExtendedTextBox Width="200"
                                      x:Name="FolderTextBox"
                                      Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                      Watermark="Select source directory" />
            <controls1:MaterialIconButton Grid.Column="1" IconSize="21" Foreground="{StaticResource ButtonFolderBrush}"
                                          Background="{StaticResource PrimaryBackgroundBrush}"
                                          Click="OnSelectFolder" Kind="{StaticResource IconFolder}"
                                          ToolTip="{x:Static resources:StringResources.DirectorySourceSettings_Button_SelectFolder}"
                                          Padding="0" Margin="0" VerticalAlignment="Bottom" FontSize="14" />

        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="10,10,0,0">
            <CheckBox IsChecked="{Binding IsActive}" Margin="0" />
            <TextBlock Text="{x:Static resources:StringResources.DirectorySourceSettings_Text_Active}" Margin="5,0,0,0" />
        </StackPanel>

    </Grid>

</UserControl>